@startuml WireInterface_2.0.0-tsi.240104.1045+diagram.completeness
skinparam responseMessageBelowArrow true

title
WireInterface_2.0.0-tsi.240104.1045+testcase.completeness
end title

participant "Postman" as Postman
participant "Data" as Data
participant "Collection" as Collection

participant "/control-construct?fields=..." as ListOfLTPUuidAndLidPairsAndNames

participant "/wire-interface-capability" as Capability
participant "/wire-interface-configuration" as Configuration
participant "/wire-interface-status" as Status
participant "/wire-interface-current-performance" as CurrentPerformance
participant "/wire-interface-historical-performances" as HistoricalPerformances
participant "/restart-pmd-negotiation" as RestartPmdNegotiation

group Preparation
  Data --\\o Postman : {servers,\n   mountName,\n   kindOfReference,\n   suffixUrlEncodingIsRequired}
  activate Postman
  Postman --\\o Collection : {servers,\n   mountName,\n   kindOfReference,\n   suffixUrlEncodingIsRequired}

  Collection --\\o Postman : {servers, mountName}
  Postman -> ListOfLTPUuidAndLidPairsAndNames : {mountName}
  Postman <-- ListOfLTPUuidAndLidPairsAndNames : {(uuid, localId, layerProtocolName)}
  note right Postman
    selection of WireInterface
  end note
  Postman --\\o Collection : {uuid, localId}
end

group /wire-interface-capability
  Collection --\\o Postman : {mountName, uuid, localId}
  Postman -> Capability : {mountName, uuid, localId}
  Postman <-- Capability : {CapabilityClass}
  note right Postman
    schema validation
  end note
end

group /wire-interface-configuration
  Collection --\\o Postman : {mountName, uuid, localId}
  Postman -> Configuration : {mountName, uuid, localId}
  Postman <-- Configuration : {ConfigurationClass}
  note right Postman
    schema validation
  end note
end

group /wire-interface-status
  Collection --\\o Postman : {mountName, uuid, localId}
  Postman -> Status : {mountName, uuid, localId}
  Postman <-- Status : {StatusClass}
  note right Postman
    schema validation
  end note
end

group /wire-interface-current-performance
  Collection --\\o Postman : {mountName, uuid, localId}
  Postman -> CurrentPerformance : {mountName, uuid, localId}
  Postman <-- CurrentPerformance : {CurrentPerformanceClass}
  note right Postman
    schema validation
  end note
end

group /wire-interface-historical-performances
  Collection --\\o Postman : {mountName, uuid, localId}
  Postman -> HistoricalPerformances : {mountName, uuid, localId}
  Postman <-- HistoricalPerformances : {HistoricalPerformancesClass}
  note right Postman
    schema validation
  end note
end

group /restart-pmd-negotiation
  Collection --\\o Postman : {mountName, uuid, \n suffixUrlEncodingIsRequired}
  Postman -> RestartPmdNegotiation : {mountName, uuid}
  Postman <-- RestartPmdNegotiation : 204
  note right Postman
    f(x)==204?
  end note
end

deactivate Postman

@enduml